OLLAMA_URL=http://localhost:11434/api/generate
LLM_MODEL=llama3.2
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=2
# Set to 1 after the embedding model has been downloaded once
HF_HUB_OFFLINE=0
HF_HUB_DISABLE_PROGRESS_BARS=1

# Business rules
RETURN_WINDOW_DAYS=30

#RAG
MIN_SIMILARITY=0.35

# Freeze today's date for evaluation (leave commented out to use the real date)
# TODAY=2026-10-26